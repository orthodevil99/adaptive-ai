# ---- Required for real answers -------------------------------------------------
# Create a key at https://console.groq.com/keys . Never commit .env or paste keys in chat.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically if the primary model is rate-limited / down. Empty = no fallback.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ---- Access control --------------------------------------------------------------
# Comma-separated keys clients must send as `X-API-Key: <key>` (or `Authorization: Bearer <key>`).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = API is open (fine on localhost; the server refuses to start that way in production).
APP_API_KEYS=
RATE_LIMIT_PER_MINUTE=120
RESPOND_RATE_LIMIT_PER_MINUTE=20

# ---- Runtime -----------------------------------------------------------------------
# development | test | production
APP_ENV=development
# groq | mock  (mock = offline fake answers for UI work / demos)
PROVIDER=groq
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./data/adaptive.db

# ---- Generation limits ---------------------------------------------------------------
MODEL_TIMEOUT_SECONDS=60
MAX_RETRIES=2
MAX_CONCURRENT_GENERATIONS=4
MAX_OUTPUT_TOKENS=4096
GROQ_REASONING=true
MAX_REQUEST_LENGTH=6000
MAX_CONTEXT_MESSAGES=12
MAX_CONTEXT_CHARS=12000

# ---- Adaptation & retention ------------------------------------------------------------
# thompson | greedy | off
ADAPTATION_MODE=thompson
MIN_FEEDBACK_SAMPLES=3
# 0 = keep conversations forever
SESSION_TTL_DAYS=0
